# Chép thành deploy/.env trên server rồi điền. KHÔNG đưa tệp .env lên GitHub (đã có trong .gitignore).
# Mật khẩu có ký tự $ thì viết thành $$.

# Mạng Docker của container SQL Server (xem bằng: docker inspect <tên-container-sql> --format '{{json .NetworkSettings.Networks}}')
SQL_NETWORK=ten-mang-cua-sql

# Tên miền thật (thay mindsprint.example.com)
App__BaseUrl=https://mindsprint.example.com
AllowedHosts=mindsprint.example.com
Passkeys__ServerDomain=mindsprint.example.com

# Database: Server = tên container SQL Server; nên tạo tài khoản SQL riêng thay cho sa.
ConnectionStrings__Default=Server=ten-container-sql,1433;Database=MindSprintAI;User Id=sa;Password=DOI_MAT_KHAU;TrustServerCertificate=True;MultipleActiveResultSets=True

# Gateway của mạng SQL_NETWORK: docker network inspect <SQL_NETWORK> --format '{{(index .IPAM.Config 0).Gateway}}'
# (Cloudflare Tunnel chạy thẳng trên server đi vào qua cổng 127.0.0.1:8080 nên app thấy yêu cầu đến từ địa chỉ này.)
ReverseProxy__KnownProxies__0=172.18.0.1

# Cloudflare Turnstile (hộp chống robot ở trang đăng ký/đăng nhập) — bắt buộc khi chạy thật.
Turnstile__SiteKey=
Turnstile__SecretKey=

# Gửi thư xác nhận email (ví dụ Gmail + mật khẩu ứng dụng). Thiếu thì người đăng ký mới không nhận được thư.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=

# Email được vào trang Quản trị
Admin__Emails__0=

# Đăng nhập Google (không bắt buộc) — xem docs/HUONG_DAN_DANG_NHAP_GOOGLE.md
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
