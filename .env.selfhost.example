# ====================================================================
# MindSprint AI - Cau hinh mau Self-Host tren Laptop (Issues #105, #106)
# Sao chep tep nay thanh .env.selfhost truoc khi khoi chay:
#   PowerShell: Copy-Item .env.selfhost.example .env.selfhost
#   Bash:       cp .env.selfhost.example .env.selfhost
#
# QUAN TRONG: Tep .env.selfhost chua mat khau/khoa that da duoc dua vao
# .gitignore va .dockerignore, TUYET DOI KHONG commit vao Git repo.
# ====================================================================

# Moi truong chay ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
SERVE_FRONTEND=true
SELF_HOST=true

# Database PostgreSQL noi bo container (chi truy cap qua mang docker bridge)
POSTGRES_DB=mindsprint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Thay_Doi_Mat_Khau_Postgres_Bao_Mat_O_Day_2026

# Khoa bi mat JWT (bat buoc >= 32 ky tu va khong dung chuoi placeholder mac dinh)
JWT_KEY=Khoa_Bi_Mat_JWT_Tu_32_Ky_Tu_Tro_Len_Cho_Ban_SelfHost_Laptop_2026

# Google Gemini API Key (tuy chon, de trong neu khong dung tinh nang AI live)
GEMINI_API_KEY=
