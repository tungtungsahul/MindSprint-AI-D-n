# Local self-host environment for laptop development.
# Copy to .env.selfhost and replace placeholder secrets before running Docker.
POSTGRES_DB=mindsprint
POSTGRES_USER=mindsprint
POSTGRES_PASSWORD=ChangeMe_2026
POSTGRES_PORT=5433
PGDATA=/var/lib/postgresql/data/pgdata

APP_PORT=8080
API_PORT=5000
FRONTEND_PORT=8080
ASPNETCORE_ENVIRONMENT=SelfHost
ASPNETCORE_URLS=http://0.0.0.0:8080

ConnectionStrings__Default=Host=postgres;Database=mindsprint;Username=mindsprint;Password=ChangeMe_2026;Port=5432
Jwt__Key=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=MindSprint-Local
Jwt__Audience=MindSprint-Local-Client
Cors__AllowedOrigins=http://127.0.0.1:8080,http://localhost:8080

Gemini__ApiKey=
Google__ClientId=
