@model string
@{
    ViewData["Title"] = "Gửi lại email xác minh";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <a class="btn btn-sm b-back" asp-action="Login"><icon name="chevron-right" class="b-back-icon" />Quay lại trang đăng nhập</a>
        <h1 class="h3 mb-3">Gửi lại email xác minh</h1>
        <form method="post" asp-action="ResendConfirmation">
            <div asp-validation-summary="All" class="text-danger small"></div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="email" value="@Model" class="form-control" required autocomplete="email" />
            </div>
            <partial name="_Turnstile" />
            <button class="btn btn-primary w-100">Gửi lại email xác minh</button>
        </form>
    </div>
</div>
