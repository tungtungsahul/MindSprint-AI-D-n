@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Đặt lại mật khẩu</h1>
        @if (ViewData["LinkInvalid"] is true)
        { <p><a asp-action="ForgotPassword">Xin link mới</a></p> }
        <form method="post">
            <div asp-validation-summary="All" class="text-danger small"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Nonce" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary w-100">Đặt lại mật khẩu</button>
        </form>
    </div>
</div>
