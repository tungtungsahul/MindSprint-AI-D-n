@model SetPasswordModel
@{
    ViewData["Title"] = "Đặt mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <a class="btn btn-sm b-back" asp-action="Login"><icon name="chevron-right" class="b-back-icon" />Quay lại trang đăng nhập</a>
        <h1 class="h3 mb-3">Đặt mật khẩu</h1>
        <form method="post" asp-action="RegisterPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            @* Pháp lý C1: chủ email đồng ý ở đây (người gõ form Đăng ký có thể là người khác). *@
            <div class="mb-3">
                <div class="consent-check">
                    <input asp-for="AcceptTerms" type="checkbox" class="form-check-input" />
                    <label asp-for="AcceptTerms" class="form-check-label">Tôi từ đủ 16 tuổi, đã đọc và đồng ý với <a asp-controller="Home" asp-action="Terms" target="_blank">Điều khoản sử dụng</a>.</label>
                </div>
                <span asp-validation-for="AcceptTerms" class="text-danger small d-block mb-2"></span>
                <div class="consent-check">
                    <input asp-for="AcceptPrivacy" type="checkbox" class="form-check-input" />
                    <label asp-for="AcceptPrivacy" class="form-check-label">Tôi đồng ý để MindSprint AI xử lý dữ liệu của tôi như <a asp-controller="Home" asp-action="Privacy" target="_blank">Chính sách quyền riêng tư</a> mô tả.</label>
                </div>
                <span asp-validation-for="AcceptPrivacy" class="text-danger small d-block"></span>
            </div>
            <button class="btn btn-primary w-100">Lưu mật khẩu</button>
        </form>
    </div>
</div>
