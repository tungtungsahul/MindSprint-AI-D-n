@model List<ClassMember>
@{ var set = (StudySet)ViewData["StudySet"]!; ViewData["Title"] = "Chọn lớp để giao bài"; }
<a class="btn btn-sm b-back" asp-controller="StudySets" asp-action="Details" asp-route-id="@set.Id"><icon name="chevron-right" class="b-back-icon" />Quay lại chi tiết bộ học</a>
<h1 class="mindsprint-title">Chọn lớp để giao bài</h1>
<p>Bộ học: <strong>@set.Title</strong>. Chọn lớp rồi kiểm tra cài đặt trước khi giao.</p>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2 class="h4">Bạn chưa có lớp để giao bài</h2><a class="btn btn-primary" asp-controller="Classrooms" asp-action="Index" asp-fragment="new-class-name">Tạo lớp</a></div>
}
else
{
    <div class="c-class-choices">
    @foreach (var membership in Model)
    {
        <a class="btn" asp-action="Create" asp-route-classroomId="@membership.ClassroomId" asp-route-studySetId="@set.Id" asp-route-quizId="@ViewData["QuizId"]"><icon name="users" />@membership.Classroom.Name</a>
    }
    </div>
}
