@model Attempt
@{
    var submission = (PaperSubmission)ViewData["Submission"]!;
    var a = (Assignment)ViewData["Assignment"]!;
    var name = Model.Participant.User?.DisplayName ?? Model.Participant.GuestDisplayName ?? "Khách";
    ViewData["Title"] = "Chấm bài — " + name;
    var score = ViewData["ScoreInput"] as decimal? ?? submission.Score;
    var comment = ViewData["CommentInput"] as string ?? submission.Comment;
}
<a class="btn btn-sm b-back" asp-action="Submissions" asp-route-id="@a.Id"><icon name="chevron-right" class="b-back-icon" />Quay lại danh sách bài nộp</a>
<h1 class="h4 mt-3 mb-1">@name — @a.PaperTitle</h1>
<p class="text-muted">Lượt @Model.AttemptNumber · nộp lúc @VnTime.Format(Model.EndedAt)@(Model.EndReason != null ? " · " + DisplayText.Of(Model.EndReason.Value) : "")
    @if (Model.ScreenLeaves.Count > 0) { <span> · rời màn hình @Model.ScreenLeaves.Count lần</span> }
    · <a asp-action="Exam" asp-route-id="@a.Id" target="_blank" rel="noopener">Xem đề</a></p>

<div class="paper-grade-layout">
    <section class="flat-section mb-3" aria-labelledby="grade-text-title">
        <h2 class="h5" id="grade-text-title">Bài viết</h2>
        @if (string.IsNullOrWhiteSpace(submission.Text)) { <p class="text-muted mb-0">Không có bài viết.</p> }
        else { <div class="paper-readonly" style="white-space: pre-wrap">@submission.Text</div> }
        <h2 class="h5 mt-3">Tệp đính kèm</h2>
        @if (submission.Files.Count == 0) { <p class="text-muted mb-0">Không có tệp.</p> }
        else
        {
            <ul class="mb-0">@foreach (var f in submission.Files.OrderBy(f => f.UploadedAt)) { <li><a asp-action="File" asp-route-id="@f.Id" target="_blank" rel="noopener">@f.FileName</a> <span class="text-muted small">(@(Math.Max(1, (f.SizeBytes + 1023) / 1024)) KB)</span></li> }</ul>
        }
    </section>

    <form method="post" asp-action="Grade" asp-route-id="@Model.Id" class="flat-section mb-3">
        <h2 class="h5">Chấm điểm</h2>
        <label class="form-label" for="score">Điểm (0–10, tối đa 2 chữ số lẻ)</label>
        <input class="form-control" id="score" name="score" type="number" min="0" max="10" step="0.01" required value="@score?.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="max-width: 10rem" />
        <label class="form-label mt-3" for="comment">Nhận xét (không bắt buộc)</label>
        <textarea class="form-control" id="comment" name="comment" rows="5" maxlength="@PaperTestService.MaxComment">@comment</textarea>
        <p class="small text-muted mt-2 mb-2">@(a.ScoresPublishedAt == null ? "Học viên chỉ thấy điểm và nhận xét sau khi bạn bấm Công bố điểm." : "Điểm đã công bố: học viên thấy ngay điểm mới khi bạn lưu.")</p>
        <button class="btn btn-primary"><icon name="check" />Lưu điểm</button>
    </form>
</div>
