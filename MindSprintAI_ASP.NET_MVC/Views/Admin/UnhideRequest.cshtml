@model UnhideRequestDetails
@{ ViewData["Title"] = "Xem yêu cầu bỏ ẩn"; var r = Model.Request; }
<a class="btn btn-sm b-back" asp-action="UnhideRequests"><icon name="chevron-right" class="b-back-icon" />Quay lại Xin bỏ ẩn bộ học</a>
<header class="section-head mt-3"><h1 class="h3">@r.StudySet.Title</h1></header>
<div class="flat-section mb-3">
    <p>Chủ bộ học: @r.Requester.DisplayName · @r.Requester.Email</p>
    <p>Gửi lúc: @VnTime.Format(r.CreatedAt)</p>
    @if (r.StudySet.HiddenByAdminAt != null)
    {
        <p class="alert alert-warning" style="white-space:pre-wrap">Lý do ẩn: @r.StudySet.HiddenReason</p>
    }
    else
    {
        @* Duyệt bỏ ẩn xóa lý do ẩn của bộ học, nên yêu cầu đã xử lý không còn lý do để hiện. *@
        <p class="alert alert-info">Bộ học này hiện không bị ẩn.</p>
    }
    <h2 class="h5">Lời giảng viên</h2>
    <p style="white-space:pre-wrap">@r.Message</p>
</div>
<section class="card card-body mb-3">
    <h2 class="h4">Nội dung hiện tại</h2>
    <p class="small text-muted">Lần xem này đã được ghi nhật ký truy cập.</p>
    @if (!r.StudySet.Quizzes.Any() && Model.Cards.Count == 0) { <p class="text-muted">Bộ học hiện không có quiz hay thẻ ghi nhớ nào.</p> }
    @foreach (var quiz in r.StudySet.Quizzes.OrderBy(q => q.CreatedAt))
    {
        <section class="mt-3">
            <h3 class="h5" style="white-space:pre-wrap">@quiz.Title</h3>
            @foreach (var question in quiz.Questions.OrderBy(q => q.OrderIndex))
            {
                <article class="border-top pt-2">
                    <h4 class="h6" style="white-space:pre-wrap">Câu @(question.OrderIndex + 1): @question.Prompt</h4>
                    <partial name="~/Views/StudySets/_QuestionAnswers.cshtml" model="question" />
                    @if (!string.IsNullOrWhiteSpace(question.Explanation)) { <p style="white-space:pre-wrap">@question.Explanation</p> }
                </article>
            }
        </section>
    }
    @if (Model.Cards.Count > 0) { <h3 class="h5 mt-3">Thẻ ghi nhớ</h3> }
    @foreach (var card in Model.Cards)
    {
        <article class="border-top pt-2"><p style="white-space:pre-wrap">@card.Front</p><p style="white-space:pre-wrap">@card.Back</p>@if (card.Example != null) { <p style="white-space:pre-wrap">Ví dụ: @card.Example</p> }</article>
    }
</section>
@if (r.Status == UnhideRequestStatus.Pending)
{
    <form method="post" asp-action="DecideUnhide" asp-route-id="@r.Id" class="flat-section mb-3" data-confirm="Bỏ ẩn bộ học này? Giảng viên giao bài lại được ngay.">
        <input type="hidden" name="approve" value="true" />
        <label for="approval-note" class="form-label">Ghi chú (không bắt buộc)</label>
        <textarea id="approval-note" name="note" maxlength="500" class="form-control mb-2">@ViewData["ApprovalNote"]</textarea>
        <button class="btn btn-primary">Bỏ ẩn</button>
    </form>
    <form method="post" asp-action="DecideUnhide" asp-route-id="@r.Id" class="flat-section mb-3" data-confirm="Từ chối yêu cầu này? Giảng viên sẽ thấy lý do bạn ghi.">
        <input type="hidden" name="approve" value="false" />
        <label for="rejection-note" class="form-label">Lý do từ chối (bắt buộc)</label>
        <textarea id="rejection-note" name="note" maxlength="500" required class="form-control mb-2">@ViewData["RejectionNote"]</textarea>
        <button class="btn btn-outline-danger">Từ chối</button>
    </form>
}
else
{
    <p>@(r.Status == UnhideRequestStatus.Approved ? "Đã bỏ ẩn bộ học." : "Đã từ chối yêu cầu.") · @VnTime.Format(r.DecidedAt)</p>
    <p style="white-space:pre-wrap">@r.DecisionNote</p>
}
