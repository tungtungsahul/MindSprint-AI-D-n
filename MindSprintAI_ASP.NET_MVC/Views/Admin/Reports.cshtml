@model List<ReportQueueRow>
@{ ViewData["Title"] = "Báo cáo vi phạm"; var page = (int)ViewData["Page"]!; }
<a class="btn btn-sm b-back" asp-action="Index"><icon name="chevron-right" class="b-back-icon" />Quay lại Quản trị</a>
<h1 class="h3 mt-2">Báo cáo vi phạm</h1>
<div class="table-responsive"><table class="table"><thead><tr><th>Báo cáo</th><th>Lý do</th><th>Trạng thái</th><th>Gửi lúc (VN)</th></tr></thead><tbody>
@foreach (var row in Model)
{
    <tr><td><a asp-action="Report" asp-route-id="@row.Id">#@row.Id · @DisplayText.Of(row.TargetType)</a></td><td>@row.Reason</td><td>@DisplayText.Of(row.Status)</td><td>@VnTime.Format(row.CreatedAt)</td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <p>Không có báo cáo ở trang này.</p> }
<nav class="d-flex gap-3" aria-label="Phân trang báo cáo">
    @if (page > 1) { <a asp-action="Reports" asp-route-page="@(page - 1)">Trang trước</a> }
    @if (Model.Count == 20) { <a asp-action="Reports" asp-route-page="@(page + 1)">Trang sau</a> }
</nav>
