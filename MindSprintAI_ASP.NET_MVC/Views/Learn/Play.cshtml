@model Attempt
@{
    var questions = (List<PlayQuestion>)ViewData["Questions"]!;
    ViewData["Title"] = "Làm bài";
    string Ids(IEnumerable<int>? ids) => ids == null ? "" : string.Join(",", ids);
    var test = Model.Participant.Assignment.Mode == AssignmentMode.Test;
    var exitMessage = test && Model.DeadlineAt != null && Model.Kind != AttemptKind.SelfReview
        ? "Thoát ra ngoài? Đồng hồ làm bài vẫn chạy trong lúc bạn ra ngoài. Các câu đã trả lời được giữ."
        : "Thoát ra ngoài? Các câu đã trả lời được giữ, bạn vào làm tiếp sau."
            + (Model.Kind == AttemptKind.SelfReview ? "" : " Hạn nộp của bài vẫn tính như cũ.");
}
@Html.AntiForgeryToken()
<div id="play" data-attempt="@Model.Id"
     data-screen-url="@(Model.MonitorScreen && Model.DeviceConsentAt != null ? Url.Action("ScreenEvent", new { id = Model.Id }) : "")"
     data-mode="@((int)Model.Participant.Assignment.Mode)"
     data-mastery="@Model.Participant.Assignment.MasteryThreshold"
     data-mastered="@Model.MasteredCount" data-mastery-total="@((ViewData["Mastery"] as MasteryProgress)?.Total)"
     data-mastery-reached="@(Model.MasteryReachedAt != null ? "1" : "0")"
     data-deadline="@(Model.DeadlineAt?.ToString("O") ?? "")"
     data-answer-url="@Url.Action("Answer", new { id = Model.Id })"
     data-open-url="@Url.Action("OpenQuestion", new { id = Model.Id })"
     data-flag-url="@Url.Action("Flag", new { id = Model.Id })"
     data-draft-url="@Url.Action("Draft", new { id = Model.Id })"
     data-state-url="@Url.Action("State", new { id = Model.Id })"
     data-assignment-url="@Url.Action("Assignment", new { id = Model.Participant.AssignmentId })"
     data-hub-url="@Url.Content("~/hubs/learn")">

    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 play-top">
        <h1 class="h5 mb-0 me-auto">Lượt @Model.AttemptNumber</h1>
        @if (Model.Kind == AttemptKind.SelfReview) { <span>Lượt tự ôn · không tính điểm</span> }
        <span id="countdown" class="badge bg-dark fs-6 d-none" role="timer" aria-label="Thời gian còn lại của lượt"></span>
        <span id="progress-text" class="small text-muted"></span>
        <form method="post" asp-action="Exit" asp-route-id="@Model.Id"
              data-confirm="@exitMessage">
            <button class="btn btn-outline-secondary">Thoát</button>
        </form>
    </div>
    <p id="deadline-text" class="small text-muted">@(Model.DeadlineAt == null ? "Không có hạn" : "Hạn: " + VnTime.Format(Model.DeadlineAt))</p>
    <p class="small text-muted" id="connection-status" role="status"></p>
    <p class="small text-warning" id="question-notice" role="status"></p>
    <p id="screen-return" class="alert alert-warning d-none" role="status" aria-live="polite"></p>
    <div class="progress mb-3" style="height: 6px" aria-hidden="true"><div id="progress-bar" class="progress-bar bg-success"></div></div>

    <div class="row g-3">
        <div class="col-lg-9 order-2 order-lg-1">
            @foreach (var q in questions)
            {
                <section class="question card d-none" data-id="@q.Id" data-type="@((int)q.Type)"
                         data-answered="@(q.Answered ? "1" : "0")" data-flagged="@(q.Flagged ? "1" : "0")"
                         data-selected="@Ids(q.Selected)" data-limit="@q.TimeLimitSeconds"
                         data-locked="@(q.Locked ? "1" : "0")" aria-label="Câu @q.Number" tabindex="-1">
                    <partial name="_PlayQuestionBody" model="@(new OpenQuestionResult(q, questions.Count, null, q.Locked, false))" />
                </section>
            }
        </div>
        <div class="col-lg-3 order-1 order-lg-2">
            <div class="card"><div class="card-body">
                <div class="small text-muted mb-2" id="navigator-title" tabindex="-1">Bảng câu hỏi</div>
                <div id="navigator" class="d-flex flex-wrap gap-1">
                    @foreach (var q in questions)
                    {
                        <button type="button" class="btn btn-sm nav-q" data-target="@q.Id" aria-label="Đi tới câu @q.Number">@q.Number<span class="nav-clock d-block small"></span></button>
                    }
                </div>
                @if (Model.Participant.Assignment.MasteryThreshold != null)
                {
                    <p id="mastery-progress" class="small mt-3" role="status">@((ViewData["Mastery"] as MasteryProgress)?.Message)</p>
                    <progress id="mastery-bar" class="w-100" value="@Model.MasteredCount" max="@((ViewData["Mastery"] as MasteryProgress)?.Total)" aria-label="Tiến độ làm chủ"></progress>
                    <div class="small mt-2">Câu sai</div><div id="wrong-questions" class="d-flex flex-wrap gap-1 mt-1"></div>
                    <button type="button" class="btn btn-outline-primary mt-2 d-none" id="practice-more">Luyện tiếp các câu còn sai</button>
                }
                <div class="small text-muted mt-2">
                    @if (test) { <span class="badge bg-primary">Đã trả lời</span> }
                    else
                    {
                        <span class="legend legend-correct"></span><span> đúng</span>
                        <span class="legend legend-wrong ms-2"></span><span> sai</span>
                    }
                    <span class="legend legend-flag ms-2"></span> đánh dấu
                </div>
                <form method="post" asp-action="Finish" asp-route-id="@Model.Id" class="mt-3" id="finish-form">
                    <button class="btn btn-success w-100" id="finish" disabled>@(Model.Participant.Assignment.MasteryThreshold == null ? "Nộp bài" : "Kết thúc lượt")</button>
                    <div class="small text-muted mt-1" id="finish-hint"></div>
                </form>
            </div></div>
        </div>
    </div>
</div>
<div class="modal fade" id="learn-notice" tabindex="-1" role="alertdialog" aria-labelledby="learn-notice-title" aria-describedby="learn-notice-message">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="learn-notice-title">Thông báo bài làm</h2></div>
        <div class="modal-body" id="learn-notice-message"></div>
        <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="learn-notice-ok">Đã hiểu</button></div>
    </div></div>
</div>

@if (!GuestAccess.IsGuest(User))
{
    <partial name="_AiAssistant" model="@(new AiPanelModel(Model.Participant.AssignmentId, Model.Id, questions.Select(q => new AiQuestionChoice(Model.Questions.First(x => x.Id == q.Id).QuestionId, $"Câu {q.Number}")).ToList()))" />
}
@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/play.js" asp-append-version="true"></script>
    <script src="~/js/learn-live.js" asp-append-version="true"></script>
    @if (Model.MonitorScreen && Model.DeviceConsentAt != null) { <script src="~/js/screen-monitor.js" asp-append-version="true"></script> }
    <script src="~/js/ai-assistant.js" asp-append-version="true"></script>
}
